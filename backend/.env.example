# Backend configuration — copy to .env (same dir) to override.
# The devcontainer already injects MONGODB_URI via docker-compose, so this
# file is only needed when running the backend outside it.

# Inside the devcontainer: mongodb://db:27017
# On the host: mongodb://localhost:27017
MONGODB_URI=mongodb://db:27017

MONGODB_DB=jnctn

# Comma-separated allowed CORS origins (only needed when the frontend is
# served from another origin — the Vite dev proxy doesn't need this).
CORS_ORIGINS=http://localhost:5173

# Gemini API key for LLM-generated analysis summaries. Without it,
# /api/analysis still works using deterministic template output.
# Get a key at https://aistudio.google.com/apikey (free tier is fine).
GEMINI_API_KEY=

# Optional model override.
GEMINI_MODEL=gemini-3-flash-preview
