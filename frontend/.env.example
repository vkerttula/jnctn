# Frontend configuration — copy to .env (same dir) to override.
# Vite exposes these to the client bundle; only VITE_* vars are read.

# API mode: "mock" (default) serves /mock/*.json fixtures — no backend
# needed. "live" calls the real FastAPI contract through the proxy.
VITE_API_MODE=live

# API base URL. Leave empty in dev: the Vite dev server proxies /api to
# the FastAPI backend on :8000. Set when serving the frontend without the
# proxy (e.g. a static deploy against a separate backend).
VITE_API_URL=
